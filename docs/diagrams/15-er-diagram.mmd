    tickers {
        int ticker_id PK
        varchar exchange
        varchar symbol
        char isin
        smallint tier
        bool is_active
    }
    historical_signals {
        bigint signal_id PK
        int ticker_id FK
        date signal_date "UNIQUE with ticker, tf"
        timestamptz bar_timestamp "week anchor"
        varchar signal_type
        smallint regime_before
        smallint regime_after
        float price_at_signal
    }
    stock_indicator_state {
        int ticker_id PK
        varchar timeframe PK
        date date PK
        float med_ema
        float long_ema
        float longest_ema
        float atr
        smallint display_regime
    }
