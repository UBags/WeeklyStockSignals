__pycache__/
*.pyc
*.pyo
.idea/
.venv/
*.egg-info/
.pytest_cache/

# Audit / temp
audit_baseline_*.txt
/tmp/

# Backup archives
*.zip

# Operator-local backtest output (regenerated by trip-ema-etl generate-signals)
generated_signals/*.json

# Local SMTP/Brevo experiments — not for the repo
tests/TestMail.py
scripts/test_smtp.py

# Brevo / Gmail / OAuth secrets — never commit
# Ignore all files in secrets/ but keep the directory + the .example
# template under version control. Real secrets files live alongside
# but are filtered out by the wildcard.
secrets/*
!secrets/.gitkeep
!secrets/*.example
!secrets/README.md
generated_signals/

# project_to_md.py — generated bundle output
Code packaged into MDs for LLMs/

# Delivery bundles for in-progress refactors — unpacked outside the repo,
# but guard against accidental `git add -A` capture
commit*_bundle/
*.bak.*

# Refactor tracking scratchpads — not for the tree
CLEAN_PIPELINE_REFACTOR_*.md

# local scratch dumps
DDL.txt
FAILS.txt
trip_ema_ddl.sql
var/etl/parked/
scripts/stock_split_evaluate.py
