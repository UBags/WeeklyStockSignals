# Brevo API key for trip-ema email transport.
#
# Setup:
#   1. cp secrets/brevo.yaml.example secrets/brevo.yaml
#   2. Edit secrets/brevo.yaml and paste your real API key.
#      Generate one at: https://app.brevo.com  -> SMTP & API -> API keys & MCP
#      Brevo keys always start with "xkeysib-".
#   3. chmod 600 secrets/brevo.yaml
#
# The real secrets/brevo.yaml is .gitignored (the whole secrets/ directory is).
# Only this .example file is tracked in git.
#
# Operational reminder: verify your sender address in Brevo's Senders
# settings before first send, or every POST returns
# `{"code":"invalid_parameter","message":"Sender ... is not valid"}`.

api_key: xkeysib-REPLACE-WITH-YOUR-REAL-KEY
